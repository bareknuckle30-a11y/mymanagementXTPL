PORT=5050

# --- Hosting behind a proxy (Render, Railway, Heroku, Nginx...) ---
# Number of proxy hops in front of this server, so the login rate limiter sees each visitor's real IP
# instead of the proxy's. Defaults to 1 when NODE_ENV=production. Use 0/false for direct exposure.
# TRUST_PROXY=1

# --- JWT -----------------------------------------------------------
# REQUIRED in production. Use a long random string, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=b4c6c6ca49380466a457622c235a3c0970e55aec5d26f93e1836f488254326b377c5c951f992e444f4b28952d5799b62
# Optional: separate secret for refresh tokens (defaults to a value derived from JWT_SECRET)
# JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_DAYS=7

# --- OTP (two-step login) ------------------------------------------
# true = every sign-in and sign-up needs a 6-digit code. false = password only.
OTP_ENABLED=true
OTP_TTL_MINUTES=5
# With no SMTP settings below, codes are printed in the server terminal AND shown on
# the login screen (development only). Set to false to hide them from the screen.
OTP_SHOW_IN_UI=true

# --- Email delivery for OTP (leave SMTP_HOST empty for console mode) -
# Copy this file to server/.env (never commit .env). Codes and password-reset
# OTPs are sent TO the user's personal mailbox (the email on their account).
# Gmail as the sending account: 2-Step Verification + App Password.
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kmrkunal5@gmail.com
SMTP_PASS=gvxbxkxapcvzszme
SMTP_FROM=XtplTask <kmrkunal5@gmail.com>
#
# Local testing without Gmail (https://ethereal.email):
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=...
# SMTP_PASS=...

# --- Email notifications (uses the same SMTP_* settings above) ------
# Emails sent: task assigned, work submitted (to admins), approved, sent back, welcome.
# Does nothing while SMTP_HOST is empty. Set to false to keep OTP mail but stop notifications.
EMAIL_NOTIFICATIONS=true
# Link shown in emails, and the sender display name
APP_URL=http://localhost:5173
APP_NAME=XTPL TaskManager

# Optional hosted chat persistence (Supabase free tier). Leave blank to use server/data/messages.json.
# Keep the service-role key on the server only; never put it in client/.env.
SUPABASE_URL=https://glauqhfddiufpfxyxlbq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here
# --- Admin self-signup with Gmail (same flow as employees: Gmail -> emailed OTP -> JWT) ---
# Admins must use a Gmail address and verify it with the OTP sent through your SMTP settings.
# Choose ONE of the options below (leave both unset to disable public admin signup):
#
# Recommended: require an invitation code. Share it only with people allowed to be admins.
ADMIN_SIGNUP_CODE=iamwebhead79
#
# Fully open, exactly like employee signup: ANY person with a Gmail account can become an
# admin. Only use this for private/local setups. Ignored when ADMIN_SIGNUP_CODE is set.
# ADMIN_SIGNUP_OPEN=true

# --- Login hour monitoring (admin: Login report) ---------------------------------
# A sign-in with no activity for this many seconds is closed at its last activity ("Closed (no activity)").
# The page checks in every 60 s, so keep this at 120 or more. Default 300.
ATTENDANCE_STALE_SECONDS=300
# Login records older than this are deleted. Default 365.
ATTENDANCE_RETENTION_DAYS=365

# --- Chat messages by email (needs the SMTP_* settings above) -----------------------
# People who are NOT in the app when a chat message arrives get a digest email. Each person can switch it
# off under Settings. Task-assignment emails are controlled by EMAIL_NOTIFICATIONS above.
CHAT_EMAIL_NOTIFICATIONS=true
# Wait this long before emailing, so someone who comes back online is not emailed (seconds, default 60)
CHAT_EMAIL_DELAY_SECONDS=60
# At most one chat email per person in this many minutes; messages are bundled (default 10)
CHAT_EMAIL_INTERVAL_MINUTES=10
# Time zone for the message times in the email (default Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata

# --- Production Supabase persistence / private object storage --------
# Required for production database mode. SERVICE_ROLE stays on the server only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-on-server-only
SUPABASE_STORAGE_BUCKET=task-attachments

# Comma-separated browser origins allowed to call the API in production.
# When frontend and API share one Nginx origin, APP_URL alone is sufficient.
CORS_ORIGINS=https://YOUR_DOMAIN
NODE_ENV=production
